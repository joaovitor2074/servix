# Modelo seguro para o Servix Beta no Railway.
# Copie os nomes para Variables no Railway; nao envie um .env real ao Git.
NODE_ENV=production
HOST=0.0.0.0

# O Railway injeta PORT. Nao fixe esse valor.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
JWT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES

TRUST_PROXY=true
FRONTEND_URL=https://SEU-PROJETO.vercel.app
CORS_ORIGINS=https://SEU-PROJETO.vercel.app

# Homologacao: nenhum destes valores habilita dinheiro real.
SERVIX_BILLING_MODE=TESTE
SERVIX_LEGAL_IDENTITY_READY=false
SERVIX_CUSTOMER_PAYMENTS_MP_MODE=DESABILITADO
SERVIX_PAYMENT_SIMULATOR_ENABLED=false
# Obrigatorio para o pre-deploy aplicar a migration do financeiro de homologacao.
SERVIX_FINANCEIRO_MODE=PREVIEW

# Assinatura hospedada do Servix. Segredos devem existir apenas no Railway.
SERVIX_SUBSCRIPTIONS_MP_MODE=TESTE
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_ACCESS_TOKEN=
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_PUBLIC_KEY=
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_PLAN_ID=
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_BACK_URL=https://SEU-PROJETO-TESTE.vercel.app
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_WEBHOOK_SECRET=

# OAuth sandbox. Deixe vazio ate cadastrar o callback HTTPS publico.
MERCADO_PAGO_OAUTH_TESTE_CLIENT_ID=
MERCADO_PAGO_OAUTH_TESTE_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_TESTE_REDIRECT_URI=https://SEU-BACKEND-TESTE.up.railway.app/integracoes/mercado-pago/callback
MERCADO_PAGO_OAUTH_TESTE_TOKEN_ENCRYPTION_KEY=
MERCADO_PAGO_TIMEOUT_MS=8000
