# Modelo de producao. Nunca copie valores do ambiente de teste.
NODE_ENV=production
HOST=0.0.0.0

DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO_PRODUCAO
JWT_SECRET=GERE_UM_SEGREDO_EXCLUSIVO_COM_32_OU_MAIS_CARACTERES

TRUST_PROXY=true
FRONTEND_URL=https://SEU-PROJETO.vercel.app
CORS_ORIGINS=https://SEU-PROJETO.vercel.app

# Dinheiro real. So altere o Railway de producao durante a virada controlada.
SERVIX_BILLING_MODE=PRODUCAO
SERVIX_SUBSCRIPTIONS_MP_MODE=PRODUCAO
SERVIX_CUSTOMER_PAYMENTS_MP_MODE=PRODUCAO
SERVIX_PAYMENT_SIMULATOR_ENABLED=false
SERVIX_FINANCEIRO_MODE=DESABILITADO

# Conta comercial do Servix. Estes nomes nunca possuem fallback para TESTE.
MERCADO_PAGO_SUBSCRIPTIONS_PRODUCAO_ACCESS_TOKEN=
MERCADO_PAGO_SUBSCRIPTIONS_PRODUCAO_PUBLIC_KEY=
MERCADO_PAGO_SUBSCRIPTIONS_PRODUCAO_PLAN_ID=
MERCADO_PAGO_SUBSCRIPTIONS_PRODUCAO_BACK_URL=https://SEU-PROJETO.vercel.app
MERCADO_PAGO_SUBSCRIPTIONS_PRODUCAO_WEBHOOK_SECRET=

# Aplicacao OAuth de producao para as contas das empresas clientes.
MERCADO_PAGO_OAUTH_PRODUCAO_CLIENT_ID=
MERCADO_PAGO_OAUTH_PRODUCAO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_PRODUCAO_REDIRECT_URI=https://SEU-BACKEND.up.railway.app/integracoes/mercado-pago/callback
MERCADO_PAGO_OAUTH_PRODUCAO_TOKEN_ENCRYPTION_KEY=
MERCADO_PAGO_TIMEOUT_MS=8000
