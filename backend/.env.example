# Banco PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/servix"

# Gere um segredo longo e exclusivo para cada ambiente.
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"

PORT=3005
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
TRUST_PROXY=false

# Chaves financeiras explicitas. NODE_ENV nunca habilita pagamentos.
# Selecione exatamente um ambiente. Cada modo le somente seu proprio namespace.
SERVIX_CUSTOMER_PAYMENTS_MP_MODE=TESTE
# Habilite apenas em desenvolvimento ou homologacao: nunca movimenta dinheiro.
SERVIX_PAYMENT_SIMULATOR_ENABLED=true

# Financeiro empresarial interno. Comeca fail-closed e nao possui gateway real.
# Use PREVIEW somente no ambiente isolado de testes; qualquer outro valor fecha
# todo o router /preview/financeiro, independentemente de NODE_ENV.
SERVIX_FINANCEIRO_MODE=DESABILITADO

# Usadas somente por `npm run finance:preview:seed`. O script tambem exige que
# o modo acima esteja em PREVIEW e nunca cria dados sem confirmacao explicita.
FINANCEIRO_PREVIEW_EMPRESA_SLUG="minha-assistencia"
POPULAR_FINANCEIRO_PREVIEW_CONFIRMAR=NAO

# Assinatura que a empresa paga ao Servix. Deve coincidir com
# SERVIX_SUBSCRIPTIONS_MP_MODE.
SERVIX_BILLING_MODE=TESTE

# Mercado Pago OAuth - credenciais globais da aplicacao Servix.
# Cada empresa deve autorizar sua propria conta sandbox; tokens avulsos legados
# no ambiente nao sao aceitos pelo fluxo de cobranca.
# O Redirect URI deve coincidir exatamente com o cadastrado no Mercado Pago.
# A chave *_TOKEN_ENCRYPTION_KEY deve ser Base64 de exatamente 32 bytes. Exemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca envie estes valores ao frontend, registre-os em logs ou reutilize a chave entre ambientes.
# ==========================================
# ASSINATURA DO SERVIX
# Conta que recebe os R$ 79,90
# ==========================================

# O checkout hospedado usa somente o Access Token no backend. Public Key e
# card_token_id nao fazem parte deste fluxo. A URL deve ser HTTPS publica.
SERVIX_SUBSCRIPTIONS_MP_MODE=TESTE
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_ACCESS_TOKEN=""
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_PUBLIC_KEY=""
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_PLAN_ID=""
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_BACK_URL="https://seu-frontend-teste.exemplo.com"
MERCADO_PAGO_SUBSCRIPTIONS_TESTE_WEBHOOK_SECRET=""

# OAuth usado pelas empresas para receber cobrancas de seus clientes.
MERCADO_PAGO_OAUTH_TESTE_CLIENT_ID=""
MERCADO_PAGO_OAUTH_TESTE_CLIENT_SECRET=""
MERCADO_PAGO_OAUTH_TESTE_REDIRECT_URI="http://localhost:3005/integracoes/mercado-pago/callback"
MERCADO_PAGO_OAUTH_TESTE_TOKEN_ENCRYPTION_KEY=""

# Timeout comum das chamadas OAuth e Orders.
MERCADO_PAGO_TIMEOUT_MS=8000

# Usadas somente pelo comando npm run admin:create
ADMIN_EMPRESA_SLUG="minha-assistencia"
ADMIN_EMPRESA_NOME="Minha Assistencia"
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_SENHA="troque-esta-senha"
