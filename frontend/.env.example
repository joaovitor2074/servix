# URL pública do backend Servix. Em produção, use HTTPS.
VITE_API_URL=http://localhost:3005

# Financeiro empresarial começa desabilitado. Use PREVIEW somente no ambiente
# isolado de testes; qualquer outro valor mantém menu e rotas bloqueados.
VITE_FINANCEIRO_PREVIEW_MODE=DESABILITADO

# Canais exibidos nas páginas públicas.
VITE_CONTACT_EMAIL=contato@servix.com.br
VITE_SUPPORT_EMAIL=suporte@servix.com.br
