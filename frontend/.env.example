# URL pública do backend Servix. Em produção, use HTTPS.
VITE_API_URL=http://localhost:3005

# Financeiro empresarial começa desabilitado. Use PREVIEW somente no ambiente
# isolado de testes; qualquer outro valor mantém menu e rotas bloqueados.
VITE_FINANCEIRO_PREVIEW_MODE=DESABILITADO

# Canais exibidos nas páginas públicas.
VITE_CONTACT_EMAIL=suporte.vercel@gmail.com
VITE_SUPPORT_EMAIL=suporte.vercel@gmail.com

# Identidade exibida publicamente nos Termos e na Política de Privacidade.
# Variáveis VITE_ fazem parte do bundle público: não use segredos. Em produção,
# preencha os três campos obrigatórios abaixo antes de liberar o checkout.
VITE_LEGAL_NAME=
VITE_LEGAL_DOCUMENT=
VITE_LEGAL_ADDRESS=
# Opcional quando o controlador possui o mesmo nome do fornecedor.
VITE_DATA_CONTROLLER_NAME=
